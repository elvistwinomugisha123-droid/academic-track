{
  "name": "academic-track",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:check": "tsx scripts/dev-check.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:product": "npm run dev:check && npm run typecheck && npm run lint && npm test && npm run build && npm audit --audit-level=high && git diff --check",
    "validate:ui": "playwright test playwright/foundation.spec.ts playwright/product-walkthrough.spec.ts playwright/assessment-walkthrough.spec.ts playwright/visual-evidence.spec.ts --reporter=line",
    "test:security:integration": "vitest run --config vitest.security.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:step7": "playwright test playwright/step7-acceptance.spec.ts",
    "eval:ai": "tsx scripts/ai-evaluation.ts",
    "step6:test-rollout": "tsx --tsconfig scripts/tsconfig.step6.json scripts/step6-test-rollout.ts",
    "knowledge:registry": "python knowledge-tools/build_source_registry.py",
    "knowledge:extract": "python knowledge-tools/extract_corpus.py",
    "db:knowledge:import": "tsx knowledge-tools/import/import-academic-knowledge.ts",
    "db:knowledge:import:production": "tsx knowledge-tools/import/import-academic-knowledge.ts --production-authorised"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "docx": "^9.7.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.25",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
