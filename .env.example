# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
ATE_ENVIRONMENT=development

# Supabase (v4 target)
# Browser-safe Supabase values. Never put service secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use the anon key in place of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Do not expose, log, or commit.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
EXPECTED_SUPABASE_PROJECT_REF=

# Dedicated isolated Supabase project for integration/security tests only.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# AI Gateway / providers
# Feature code must use the ATE AI Gateway rather than provider SDKs directly.
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=
ANTHROPIC_MODEL=
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_PAYLOAD_BYTES=120000

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Pilot Web Push (required for Gate 5 configuration proof)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
CRON_SECRET=

# Background jobs
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Observability
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# External resource discovery (enable only when configured)
YOUTUBE_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Optional invitation/notification provider
SMS_PROVIDER=
SMS_API_KEY=
