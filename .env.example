# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (v4 target)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI Gateway / providers
# Feature code must use the ATE AI Gateway rather than provider SDKs directly.
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Background jobs
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Observability
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# External resource discovery (enable only when configured)
YOUTUBE_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Optional invitation/notification provider
SMS_PROVIDER=
SMS_API_KEY=
